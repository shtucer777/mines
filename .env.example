# Stake.com API authentication
STAKE_API_TOKEN=your_api_token_here

# Betting configuration
BET_AMOUNT=0.00001
MINES_COUNT=3
MAX_ROUNDS=50
AUTO_CASHOUT_MULTIPLIER=1.5

# Rate limiting (seconds between bets)
BET_DELAY=2.0

# Strategy: conservative | moderate | aggressive | martingale
STRATEGY=conservative
